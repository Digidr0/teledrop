{
  "name": "teledrop",
  "version": "1.0.0",
  "description": "Telegram media receiver for Windows 11",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "lint": "eslint src",
    "format": "prettier --write src *.json *.ts *.js *.md",
    "format:check": "prettier --check src *.json *.ts *.js *.md",
    "tauri": "tauri",
    "build:windows": "tauri build --bundles nsis",
    "build:portable": "tauri build --no-bundle"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/svelte": "^1.1.5",
    "@tauri-apps/api": "^2.12.3",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "svelte": "^5.57.2",
    "tailwind-merge": "^3.7.0"
  }
}
